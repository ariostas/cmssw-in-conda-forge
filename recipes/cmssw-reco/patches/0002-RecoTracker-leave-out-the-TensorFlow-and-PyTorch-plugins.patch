diff --git a/RecoTracker/FinalTrackSelectors/plugins/BuildFile.xml b/RecoTracker/FinalTrackSelectors/plugins/BuildFile.xml
index 2235acdc2..b55c1fa80 100644
--- a/RecoTracker/FinalTrackSelectors/plugins/BuildFile.xml
+++ b/RecoTracker/FinalTrackSelectors/plugins/BuildFile.xml
@@ -1,3 +1,15 @@
+<!--
+  The plugins that run a TensorFlow inference are left out. conda-forge has
+  libtensorflow_cc, but its C++ headers do not compile: allocator.h includes
+  "xla/tsl/framework/allocator.h", which the package does not ship, so anything including
+  tensor.h fails. SKIP_FILES removes exactly those source files, so every other plugin in
+  this package still builds. Restore the <use> and drop the SKIP_FILES flag once the
+  feedstock ships a complete header tree.
+-->
+<!--
+  The alpaka plugins here go with them: they run a PyTorch model through
+  PhysicsTools/PyTorchAlpaka and want `xtd` and, on the cuda backend, pytorch-cuda.
+-->
 <use name="ofast-flag"/>
 <use name="CommonTools/Statistics"/>
 <use name="CommonTools/Utils"/>
@@ -23,7 +35,6 @@
 <use name="Geometry/TrackerGeometryBuilder"/>
 <use name="MagneticField/Engine"/>
 <use name="MagneticField/Records"/>
-<use name="PhysicsTools/TensorFlow"/>
 <use name="RecoLocalTracker/SiStripClusterizer"/>
 <use name="RecoTracker/FinalTrackSelectors"/>
 <use name="RecoTracker/Record"/>
@@ -36,21 +47,7 @@
 <use name="roottmva"/>
 <use name="lwtnn"/>
 <library file="*.cc" name="RecoTrackerFinalTrackSelectorsPlugins">
+  <flags SKIP_FILES="TrackTfClassifier.cc"/>
   <flags EDM_PLUGIN="1"/>
 </library>
 
-<library file="alpaka/*.cc" name="RecoTrackerFinalTrackSelectorsAlpakaPlugins">
-  <use name="alpaka"/>
-  <use name="xtd"/> 
-  <use name="DataFormats/BeamSpot"/>
-  <use name="DataFormats/Portable"/>
-  <use name="DataFormats/SoATemplate"/>
-  <use name="HeterogeneousCore/AlpakaCore"/>
-  <use name="HeterogeneousCore/AlpakaInterface"/>
-  <use name="PhysicsTools/PyTorch"/>
-  <use name="PhysicsTools/PyTorchAlpaka"/>
-  <use name="pytorch-cuda" for="alpaka/cuda"/>
-  <flags ALPAKA_BACKENDS="1"/>
-  <flags EDM_PLUGIN="1"/>
-  <flags remove="1">ofast-flag</flags>
-</library>
