diff --git a/Geometry/CSCGeometryBuilder/plugins/BuildFile.xml b/Geometry/CSCGeometryBuilder/plugins/BuildFile.xml
index a73fe526e..b4e286e1e 100644
--- a/Geometry/CSCGeometryBuilder/plugins/BuildFile.xml
+++ b/Geometry/CSCGeometryBuilder/plugins/BuildFile.xml
@@ -1,3 +1,11 @@
+<!--
+  The *GeometryValidate plugins compare the geometry against a reference through
+  Fireworks/Core, the event display. Fireworks needs OpenGL and the ROOT GUI and Eve
+  libraries, none of which this layer has any other reason to carry, and the plugins are a
+  debugging tool rather than part of reconstruction. They are left out here; every other
+  plugin in these packages, including the ESModules that actually build the muon geometry,
+  is unaffected.
+-->
 <use name="CondFormats/Alignment"/>
 <use name="CondFormats/GeometryObjects"/>
 <use name="FWCore/Framework"/>
@@ -13,9 +21,3 @@
   <flags EDM_PLUGIN="1"/>
 </library>
 
-<library name="CSCGeometryValidationPlugins" file="CSCGeometryValidate.cc">
-  <use name="Fireworks/Core"/>
-  <use name="Geometry/CSCGeometry"/>
-  <use name="rootgeom"/>
-  <flags EDM_PLUGIN="1"/>
-</library>
