-                                                             {parT::kChargedCandidates4Vec, target_n_cpf},
-                                                             {parT::kNeutralCandidates4Vec, target_n_npf},
-                                                             {parT::kVertices4Vec, target_n_vtx}};
-
-  // loop through all groups of features
