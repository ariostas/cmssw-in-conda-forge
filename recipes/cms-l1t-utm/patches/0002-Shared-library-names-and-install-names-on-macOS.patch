diff --git a/config/mfCommonDefs.mk b/config/mfCommonDefs.mk
index 0fbd145..740bcd7 100644
--- a/config/mfCommonDefs.mk
+++ b/config/mfCommonDefs.mk
@@ -20,6 +20,15 @@ MKDEPEND = c++ -MMD -MP
 RM = rm -f
 TOUCH = touch
 
+# shared libraries: macOS names them .dylib, and records an install name in them
+ifeq ($(shell uname -s),Darwin)
+SOEXT = dylib
+SONAME_FLAGS = -Wl,-install_name,@rpath/$(LIBRARY)
+else
+SOEXT = so
+SONAME_FLAGS = -Wl,-soname,$(LIBRARY)
+endif
+
 # temp
 GARBAGE = core* *.o *~ *.d *.log a.out gmon.out
 
diff --git a/config/mfRules.mk b/config/mfRules.mk
index a8ac64c..7755023 100644
--- a/config/mfRules.mk
+++ b/config/mfRules.mk
@@ -8,7 +8,7 @@ _DEPS = $(SRCS:.cc=.d)
 all: $(LIBRARY) $(PROGRAMS) _all
 
 $(LIBRARY): $(_OBJS)
-	$(AR) -o $@ $^ $(LIBDIR) $(LIBS)
+	$(AR) -o $@ $^ $(SONAME_FLAGS) $(LIBDIR) $(LIBS)
 
 $(PROGRAMS): %: %.o
 	$(CXX) -o $@ $(CXXFLAGS) $(CPPFLAGS) $(LIBDIR) $< $(LIBS)
diff --git a/tmEventSetup/Makefile.default b/tmEventSetup/Makefile.default
index 2c16bae..2b4064e 100644
--- a/tmEventSetup/Makefile.default
