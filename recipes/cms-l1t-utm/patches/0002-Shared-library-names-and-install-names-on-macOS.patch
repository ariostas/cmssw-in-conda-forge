@@ -2,7 +2,7 @@ include ../config/mfCommonDefs.mk
 
 PACKAGE = tmEventSetup
 VERSION = 0.14.1
-LIBRARY = libtmeventsetup.so
+LIBRARY = libtmeventsetup.$(SOEXT)
 
 # install prefix
