<tool name="dd4hep-core" version="1.37" path="@PREFIX@" revision="1">
  <info url="https://github.com/AIDASoft/DD4hep"/>
  <lib name="DDCore"/>
  <lib name="DDParsers"/>
  <client>
    <environment name="LIBDIR" default="$TOOL_BASE/lib"/>
    <environment name="INCLUDE" default="$TOOL_BASE/include"/>
  </client>
  <runtime name="ROOT_INCLUDE_PATH" value="$INCLUDE" type="path"/>
  <runtime name="PATH" value="$TOOL_BASE/bin" type="path"/>
  <flags LISTCOMPONENTS="$TOOL_BASE/bin/listcomponents_dd4hep"/>
  <!--
    CMS builds DD4hep with DD4HEP_USE_GEANT4_UNITS=ON and compiles CMSSW with the matching
    define. conda-forge's DD4hep is built without it, so it uses TGeo units, and defining it
    here would make CMSSW and the DD4hep library disagree about lengths by a factor of ten
    wherever a value crosses the library boundary. The define is therefore left out, so both
    sides agree on TGeo units.

    That is correct and not merely self consistent, and it has been checked against CMS's own
    build of this release rather than argued: the stored geometry differs by exactly ten in
    every one of 1250 numeric fields and in nothing else, the dd4hep unit constants differ by
    ten in the same direction, and every quantity converted the way CMSSW converts it agrees
    exactly. CMSSW never assumes what dd4hep's base unit is: all 511 references to dd4hep::mm,
    dd4hep::cm and dd4hep::deg in the release are conversions, and no file mixes them with CLHEP
    units. See cmssw-notes/geometry-comparison/ for how to reproduce it.
  -->
  <use name="root_cxxdefaults"/>
  <use name="root"/>
  <use name="boost"/>
  <use name="xerces-c"/>
  <use name="clhep"/>
</tool>
