<tool name="dd4hep-core" version="1.33" path="@PREFIX@" revision="1">
  <info url="https://github.com/AIDASoft/DD4hep"/>
  <lib name="DDCore"/>
  <lib name="DDParsers"/>
  <client>
    <environment name="LIBDIR" default="$TOOL_BASE/lib"/>
    <environment name="INCLUDE" default="$TOOL_BASE/include"/>
  </client>
  <runtime name="ROOT_INCLUDE_PATH" value="$INCLUDE" type="path"/>
  <runtime name="PATH" value="$TOOL_BASE/bin" type="path"/>
  <flags LISTCOMPONENTS="$TOOL_BASE/bin/listcomponents_dd4hep"/>
  <!--
    CMS builds DD4hep with DD4HEP_USE_GEANT4_UNITS=ON and compiles CMSSW with the matching
    define. conda-forge's DD4hep is built without it, so it uses TGeo units, and defining it
    here would make CMSSW and the DD4hep library disagree about lengths by a factor of ten
    wherever a value crosses the library boundary. The define is therefore left out, so both
    sides agree on TGeo units.

    That is very likely correct and not merely self consistent: CMSSW never assumes what
    dd4hep's base unit is. All 511 references to dd4hep::mm, dd4hep::cm and dd4hep::deg in the
    release are conversions -- 335 divide by one, 167 multiply by one, and the remaining few
    define named scale constants (k_ScaleToDD4hep and friends) that are then used the same way.
    No file mixes them with CLHEP units. Still to be confirmed numerically against the CVMFS
    release once a geometry layer exists. See PLAN.md.
  -->
  <use name="root_cxxdefaults"/>
  <use name="root"/>
  <use name="boost"/>
  <use name="xerces-c"/>
  <use name="clhep"/>
</tool>
