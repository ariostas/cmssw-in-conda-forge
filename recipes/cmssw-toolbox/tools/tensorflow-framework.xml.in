<tool name="tensorflow-framework" version="2.19.1" path="@PREFIX@" revision="2">
  <!--
    CMS's tool file also names giflib, libjpeg-turbo and zlib, because its own build of
    TensorFlow links them dynamically. conda-forge's libtensorflow_framework has them resolved
    already. protobuf stays: the headers include TensorFlow's generated .pb.h files.
  -->
  <lib name="tensorflow_framework"/>
  <use name="tensorflow"/>
  <use name="protobuf"/>
</tool>
