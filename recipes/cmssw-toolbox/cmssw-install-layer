#!/usr/bin/env python3
"""Install the build products of a SCRAM developer area into the release it was built on.

A CMSSW release installed by conda is assembled from several packages (layers), each of
which builds a set of CMSSW packages in a developer area on top of the layers already
installed. conda packages may not share files, so only files that the release does not
have yet are installed; a file that the release already has with different content is an
error, unless the directory it is in says otherwise (see SUBDIRS).
"""

import argparse
import filecmp
import os
import shutil
import subprocess
import sys

# Directories of the area that hold installable products, relative to its top; @ is the SCRAM
# architecture. The policy says what to do when the release already has a file:
#   "new"   every file must be new (identical files are skipped)
#   "init"  as "new", but the per-subsystem python __init__.py markers may already be there
#   "keep"  the release's version wins; these are per-tool files whose compiler paths are
#           specific to the build that produced them, and only the release's are used again
SUBDIRS = [
    ("lib/@", "new"),
    ("bin/@", "new"),
    ("src", "new"),
    ("python", "init"),
    ("cfipython/@", "init"),
    # build metadata, so that later layers and developer areas can build against this one
    (".SCRAM/@/MakeData/DirCache", "new"),
    (".SCRAM/@/BuildFiles", "keep"),
    (".SCRAM/@/tools", "keep"),
    (".SCRAM/@/InstalledTools", "keep"),
    ("config/toolbox/@/tools/selected", "keep"),
]

# python namespace package markers: one per subsystem, owned by whichever layer got there first
INIT_NAMES = ("__init__.py", "__init__.pyc")


def same(a, b):
    if os.path.islink(a) or os.path.islink(b):
        return os.path.islink(a) and os.path.islink(b) and os.readlink(a) == os.readlink(b)
    return filecmp.cmp(a, b, shallow=False)


def is_init(rel, name):
    if name in INIT_NAMES:
        return True
    # __pycache__/__init__.cpython-312.pyc, which embeds the path it was compiled from
    return os.path.basename(rel) == "__pycache__" and name.startswith("__init__.")


def install(src_dir, dst_dir, policy):
    copied = skipped = 0
    clashes = []
    for root, dirs, files in os.walk(src_dir):
        rel = os.path.relpath(root, src_dir)
        dst_root = os.path.join(dst_dir, rel) if rel != "." else dst_dir
        os.makedirs(dst_root, exist_ok=True)
        # a symlinked directory is copied as a symlink, not walked
        for name in list(dirs):
            src = os.path.join(root, name)
            if not os.path.islink(src):
                continue
            dirs.remove(name)
            files.append(name)
        for name in files:
            src = os.path.join(root, name)
            dst = os.path.join(dst_root, name)
            if os.path.lexists(dst):
                if same(src, dst) or policy == "keep" or (policy == "init" and is_init(rel, name)):
                    skipped += 1
                else:
                    clashes.append(os.path.join(rel, name))
                continue
            if os.path.islink(src):
                os.symlink(os.readlink(src), dst)
            else:
                shutil.copy2(src, dst)
            copied += 1
    return copied, skipped, clashes


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--from", dest="src", required=True)
    parser.add_argument("--to", dest="dst", required=True)
    parser.add_argument("--arch", required=True)
    args = parser.parse_args()

    clashes = []
    for subdir, policy in SUBDIRS:
        sub = subdir.replace("@", args.arch)
        src = os.path.join(args.src, sub)
        if not os.path.isdir(src):
            continue
        copied, skipped, bad = install(src, os.path.join(args.dst, sub), policy)
        print("%-40s %5d new, %5d unchanged" % (sub, copied, skipped))
        clashes += [os.path.join(sub, c) for c in bad]

    # macOS: python cannot import a .dylib, and a few CMSSW libraries are extension modules
    if args.arch.startswith("osx"):
        subprocess.check_call([
            "cmssw-link-python-modules",
            "--from", os.path.join(args.src, "lib", args.arch),
            "--to", os.path.join(args.dst, "lib", args.arch),
        ])

    if clashes:
        print("\nERROR: these files already exist in the release with different content:",
              file=sys.stderr)
        for c in clashes:
            print("  " + c, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
