#!/usr/bin/env python3
"""Instantiate the CMSSW SCRAM tool file templates for a conda environment.

usage: cmssw-generate-toolbox <outdir> [--prefix PREFIX] [--templates DIR]

Writes <outdir>/tools/selected/<tool>.xml. Compilers are taken from $CXX, $CC and
$FC (as set by the conda compiler activation scripts), or looked up in PATH.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import sysconfig


def find_program(env, candidates):
    if os.environ.get(env):
        prog = os.environ[env].split()[0]
        return shutil.which(prog) or prog
    for c in candidates:
        path = shutil.which(c)
        if path:
            return path
    return candidates[0]


def missing_paths(text, prefix):
    """The <client> <environment> defaults of a tool file that do not exist in the prefix.

    SCRAM checks them when the tool is set up, so a tool file may only be written if the
    package it describes is actually installed.
    """
    missing = []
    for value in re.findall(r'<environment\s+name="(?:INCLUDE|LIBDIR|BINDIR)"\s+default="([^"]+)"', text):
        path = value.replace("$TOOL_BASE", prefix)
        if path.startswith("/") and not os.path.exists(path):
            missing.append(path[len(prefix) + 1:] if path.startswith(prefix) else path)
    return missing


def output(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except (OSError, subprocess.CalledProcessError):
        return ""


def main():
    here = os.path.dirname(os.path.realpath(__file__))
    parser = argparse.ArgumentParser()
    parser.add_argument("outdir")
    parser.add_argument("--prefix", default=os.environ.get("PREFIX", os.environ.get("CONDA_PREFIX", sys.prefix)))
    parser.add_argument("--templates", default=os.path.join(here, "..", "share", "cmssw-toolbox", "tools"))
    args = parser.parse_args()
    if not os.path.isdir(args.templates):
        args.templates = os.path.join(here, "tools")

    cxx = find_program("CXX", ["c++", "g++", "clang++"])
    # clang, for the CondFormats serialization generator (libclang) and the LLVM analyzer
    clangxx = shutil.which("clang++") or ""
    clang = shutil.which("clang") or ""
    clang_version = re.sub(r".*version ([0-9.]+).*", r"\1", output([clangxx, "--version"]).split("\n")[0]) if clangxx else ""
    gcc_version = output([cxx, "-dumpfullversion"]) or output([cxx, "-dumpversion"]) or "0.0.0"
    major, minor, patch = (gcc_version.split(".") + ["0", "0"])[:3]
    make_version = re.sub(r"^GNU Make ", "", output(["make", "--version"]).split("\n")[0])
    # ROOT built with Vc needs the (static) Vc library, its headers reference Vc symbols
    rconfigure = os.path.join(args.prefix, "include", "RConfigure.h")
    root_has_vc = os.path.exists(rconfigure) and re.search(r"#define\s+R__HAS_VC\b", open(rconfigure).read())
    values = {
        "PREFIX": os.path.abspath(args.prefix),
        "CXX": cxx,
        "CC": find_program("CC", ["cc", "gcc", "clang"]),
        "FC": find_program("FC", ["gfortran"]),
        "GCC_VERSION": gcc_version,
        "GLIBCXX_VERSION": "%d%02d%02d" % (int(major), int(minor), int(patch)),
        # PY_VER is set by conda-build/rattler-build for the host python
        "PYTHON_VERSION": os.environ.get("PY_VER") or sysconfig.get_python_version(),
        # boost's python library is named after the version without the dot, e.g. boost_python312
        "PYTHON_VERSION_NODOT": (os.environ.get("PY_VER") or sysconfig.get_python_version()).replace(".", ""),
        "MAKE_VERSION": make_version or "4",
        "CLANGXX": clangxx,
        "CLANG": clang,
        "CLANG_VERSION": clang_version or "0.0.0",
        "ROOT_VC_LIB": '<lib name="Vc"/>' if root_has_vc else "",
        # macOS: pass the SDK explicitly, so that SDKROOT/CONDA_BUILD_SYSROOT do not need to be set
        # while building (ROOT's interpreter, which runs during the build, breaks with some SDKs)
        "SYSROOT_FLAGS": ("-isysroot " + os.environ["CONDA_BUILD_SYSROOT"]) if os.environ.get("CONDA_BUILD_SYSROOT") else "",
    }

    selected = os.path.join(args.outdir, "tools", "selected")
    os.makedirs(selected, exist_ok=True)
    os.makedirs(os.path.join(args.outdir, "tools", "available"), exist_ok=True)
    # platform specific templates (e.g. tools-osx/) replace the generic ones with the same name
    templates = {n: os.path.join(args.templates, n) for n in os.listdir(args.templates)}
    overlay = os.path.join(os.path.dirname(os.path.abspath(args.templates)), "tools-" + ("osx" if sys.platform == "darwin" else "linux"))
    if os.path.isdir(overlay):
        templates.update({n: os.path.join(overlay, n) for n in os.listdir(overlay)})
    skipped = []
    for name in sorted(templates):
        if not name.endswith(".xml.in"):
            continue
        text = open(templates[name]).read()
        text = re.sub(r"@([A-Z_]+)@", lambda m: values.get(m.group(1), m.group(0)), text)
        leftover = re.findall(r"@[A-Z_]+@", text)
        if leftover:
            sys.exit("ERROR: unresolved placeholders %s in %s" % (leftover, name))
        missing = missing_paths(text, values["PREFIX"])
        if name.startswith("llvm-") and not clangxx:
            missing = missing or ["clang++"]
        if missing:
            # SCRAM refuses to set up a tool whose directories do not exist, so a tool of a
            # package that is not part of this build is left out. A build that needs it fails
            # with "Unknown tool", which points back here.
            skipped.append("%s (%s)" % (name[: -len(".xml.in")], ", ".join(missing)))
            continue
        with open(os.path.join(selected, name[: -len(".in")]), "w") as f:
            f.write(text)
    if skipped:
        print("Not installed in this environment, tool files left out:\n  %s" % "\n  ".join(skipped))
    print("Generated SCRAM toolbox in %s" % selected)


if __name__ == "__main__":
    main()
