  <!-- macOS: the "gcc" compiler tool is conda-forge's clang with libc++ -->
  <tool name="gcc-cxxcompiler" version="@GCC_VERSION@" type="compiler" revision="4">
    <client>
      <environment name="CXX" value="@CXX@"/>
    </client>
    <!-- conda-forge's libc++ keeps Apple's availability annotations, which say a feature is
         missing whenever the macOS version it shipped in is older than the deployment target.
         They do not apply here: the libc++ that is used at run time is the one from the conda
         environment, not the system's. Without this, anything that includes <charconv> fails to
         compile with "expected ')'": the annotation for features from LLVM 20, such as the
         floating point std::from_chars, is deliberately an invalid attribute pointing at
         https://conda-forge.org/docs/maintainer/knowledge_base.html#newer-c-features-with-old-sdk.
         conda-forge's own ROOT builds with the same define. -->
    <flags CPPDEFINES="GNU_GCC _GNU_SOURCE _LIBCPP_DISABLE_AVAILABILITY"/>
    <flags CXXSHAREDOBJECTFLAGS="-fPIC"/>
    <flags CXXFLAGS="@SYSROOT_FLAGS@"/>
    <flags CXXFLAGS="-O3 -pthread -pipe -std=c++20 -ftree-vectorize -fvisibility-inlines-hidden -fno-math-errno"/>
    <flags CXXFLAGS="-Wall -Wextra -Wno-long-long -Wreturn-type -Wpessimizing-move"/>
    <flags CXXFLAGS="-Wno-cast-function-type -Wno-unused-but-set-parameter -Wno-ignored-qualifiers -Wno-unused-parameter"/>
    <flags CXXFLAGS="-Wunused -Wparentheses -Werror=return-type -Werror=unused-value -Werror=unused-result -Werror=unused-label"/>
    <flags CXXFLAGS="-Werror=address -Werror=format -Werror=sign-compare -Werror=write-strings -Werror=delete-non-virtual-dtor"/>
    <flags CXXFLAGS="-Werror=narrowing -Werror=reorder -Werror=unused-variable -Wnon-virtual-dtor -Werror=switch"/>
    <flags CXXFLAGS="-Wno-unused-local-typedefs -Wno-attributes -Wno-psabi"/>
    <!-- same as CMS's llvm-cxxcompiler tool -->
    <flags CXXFLAGS="-Wno-c99-extensions -Wno-c++11-narrowing -Wno-unused-private-field -Wno-unknown-pragmas"/>
    <flags CXXFLAGS="-Wno-unused-command-line-argument -Wno-unknown-warning-option -ftemplate-depth=512"/>
    <flags CXXFLAGS="-Wno-error=potentially-evaluated-expression -Wno-tautological-type-limit-compare -Wno-vla-cxx-extension"/>
    <flags CXXFLAGS="-fsized-deallocation"/>
    <!-- conda-forge's Linux gcc is configured with the conda prefix in its default library
         search path ("the compiler adds ${PREFIX}/lib to rpath", says its activation script);
         its macOS clang is not, and only gets there through LDFLAGS at build time. SCRAM builds
         its own link line, so without this nothing outside the release is found: a developer
         area fails with "ld: library not found for -lTree" the moment a package is rebuilt.
         The layer builds pass the same flags as USER_LDFLAGS, which hid this until now. -->
    <flags LDFLAGS="-L@PREFIX@/lib -Wl,-rpath,@PREFIX@/lib"/>
    <flags LDFLAGS="@SYSROOT_FLAGS@ -Wl,-headerpad_max_install_names"/>
    <flags CXXSHAREDFLAGS="@SYSROOT_FLAGS@ -dynamiclib -Wl,-headerpad_max_install_names"/>
    <flags LD_UNIT="-r"/>
  </tool>
