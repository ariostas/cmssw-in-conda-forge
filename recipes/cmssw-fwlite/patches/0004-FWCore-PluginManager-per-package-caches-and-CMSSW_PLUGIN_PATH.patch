+        // A release split into several separately installed packages (e.g. conda packages)
+        // can not share a single cache file, so each package provides its own cache in a
+        // '<cache file>.d' directory.
+        std::filesystem::path cacheDir = dir / (kCacheFile.string() + ".d");
+        if (is_directory(cacheDir)) {
+          std::vector<std::filesystem::path> cacheFiles;
+          for (auto const& entry : std::filesystem::directory_iterator(cacheDir)) {
+            if (entry.is_regular_file()) {
+              cacheFiles.push_back(entry.path());
+            }
+          }
+          std::sort(cacheFiles.begin(), cacheFiles.end());
+          for (auto const& file : cacheFiles) {
+            if (readCacheFile(file, dir, categoryToInfos_)) {
+              foundAtLeastOneCacheFile = true;
+            }
+          }
+        }
+
         // We do not check for return code since we do not want to consider a
         // poison cache file as a valid cache file having been found.
         std::filesystem::path poisonedCacheFile = dir / kPoisonedCacheFile;
