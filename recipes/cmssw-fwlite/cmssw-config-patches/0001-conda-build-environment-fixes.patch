diff --git a/Projects/CMSSW/Self.xml b/Projects/CMSSW/Self.xml
index 1363685..65ae67a 100644
--- a/Projects/CMSSW/Self.xml
+++ b/Projects/CMSSW/Self.xml
@@ -42,6 +42,10 @@
  <runtime name="LD_LIBRARY_PATH"       value="$LOCALTOP/biglib/$SCRAM_ARCH"          type="path"/>
  <runtime name="LD_LIBRARY_PATH"       value="$LOCALTOP/lib/$SCRAM_ARCH"             type="path"/>
  <runtime name="LD_LIBRARY_PATH"       value="$LOCALTOP/external/$SCRAM_ARCH/lib"    type="path" handler="warn"/>
+ <!-- ROOT finds dictionaries (rootmaps/pcms) via ROOT_LIBRARY_PATH too. On macOS DYLD_* variables are
+      removed by SIP when running e.g. /usr/bin/env, so the library path alone is not reliable. -->
+ <runtime name="ROOT_LIBRARY_PATH"     value="$LOCALTOP/biglib/$SCRAM_ARCH"          type="path"/>
+ <runtime name="ROOT_LIBRARY_PATH"     value="$LOCALTOP/lib/$SCRAM_ARCH"             type="path"/>
  <runtime name="PATH"                  value="$LOCALTOP/bin/$SCRAM_ARCH"             type="path"/>
  <runtime name="PATH"                  value="$LOCALTOP/external/$SCRAM_ARCH/bin"    type="path" handler="warn"/>
  <runtime name="PYTHON3PATH"            value="$LOCALTOP/python"                     type="path" handler="warn"/>
diff --git a/SCRAM/GMake/Makefile.rules b/SCRAM/GMake/Makefile.rules
index bf0879f..e3463a9 100644
--- a/SCRAM/GMake/Makefile.rules
+++ b/SCRAM/GMake/Makefile.rules
@@ -132,7 +132,9 @@ POISON_EDMPLUGIN_CACHE      :=
 EDM_CHECKSUM_HELP_MSG       = Suggestion: You can run 'scram build updateclassversion' to generate $$x.generated with updated ClassVersion
 CMDS_COMPILERS_MAP          := CXX:g++ CC:gcc FC:g77
 ALL_CMDS                    := sh awk basename cat cd chmod cp dirname diff echo false find g77 g++ c++ gcc grep ln ls mkdir mv printf python python2 python3 md5sum rm sed sort touch tr true uname uniq xargs ld wc cut git gunzip tail head objcopy ar rsync
-SHELL                       := /bin/sh
+# The rules use bash features (e.g. $'\n'), do not rely on /bin/sh being bash. Prefer the bash
+# from PATH: on macOS, SIP strips DYLD_* variables when running the system /bin/bash.
+SHELL                       := $(firstword $(shell command -v bash 2>/dev/null) $(wildcard /bin/bash) /bin/sh)
 BASECMD_which               := which
 CMD_cd  := cd
 ifdef CXX
diff --git a/SCRAM/run_gmake.sh b/SCRAM/run_gmake.sh
index 091180a..e6967a1 100755
--- a/SCRAM/run_gmake.sh
+++ b/SCRAM/run_gmake.sh
@@ -5,4 +5,7 @@ if [ ! -f ${SCRAM_INTwork}/Makefile ] ; then
   cp ${SCRAM_CONFIGDIR}/SCRAM/GMake/Makefile ${SCRAM_INTwork}/Makefile
   touch -t 198001010100 ${SCRAM_INTwork}/Makefile
 fi
-(${SCRAM_GMAKE_PATH}gmake -r -f ${SCRAM_INTwork}/Makefile "$@" && [ ! -e ${errfile} ]) || (err=$?; echo "gmake: *** [There are compilation/build errors. Please see the detail log above.] Error $err" && exit $err)
+GMAKE="${SCRAM_GMAKE_PATH}gmake"
+# conda-forge only provides GNU make as "make"
+[ -x "$(command -v ${GMAKE})" ] || GMAKE="${SCRAM_GMAKE_PATH}make"
+(${GMAKE} -r -f ${SCRAM_INTwork}/Makefile "$@" && [ ! -e ${errfile} ]) || (err=$?; echo "gmake: *** [There are compilation/build errors. Please see the detail log above.] Error $err" && exit $err)
